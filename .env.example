# Copiez ce fichier en .env.local et renseignez les valeurs (et ajoutez-les dans Vercel > Settings > Environment Variables).

# URL publique du chat n8n (page « Démo secrétariat IA »). Transmise au navigateur par /api/cabinet/config.
NEXT_PUBLIC_N8N_CHAT_URL=

# Côté serveur uniquement : ne jamais exposer au navigateur.
N8N_DASHBOARD_URL=
N8N_STATUT_URL=
N8N_API_KEY=

# Protection de la page « Dashboard cabinet » (données patients).
# DASHBOARD_PASSWORD : mot de passe partagé par l'équipe (8 caractères minimum).
# AUTH_SECRET : chaîne aléatoire de 32 caractères minimum (signature du cookie de session).
DASHBOARD_PASSWORD=
AUTH_SECRET=
